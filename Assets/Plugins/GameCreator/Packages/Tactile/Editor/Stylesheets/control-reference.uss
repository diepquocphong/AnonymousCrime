#Tactile-Control-Reference 
{
    margin-left: 3px;
    margin-right: 1px;

    flex-direction: row;
    flex-wrap: nowrap;
}

#Tactile-Control-Reference > Label 
{
    -unity-text-align: middle-left;
}

#Tactile-Control-Reference > PropertyField 
{
    margin-left: -1px;

    flex-basis: 70px;
    flex-grow: 0;
    flex-shrink: 1;
}

#Tactile-Control-Reference > VisualElement
{
    flex-grow: 1;
    flex-shrink: 1;
}

#Tactile-Control-Reference > VisualElement Label
{
    margin-right: 0;
    padding-right: 0;
}