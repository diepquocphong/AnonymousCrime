Vector2IntField .unity-composite-field__field-spacer
{
    display: none;
}

LabelTitle
{
    margin-left: 0;
}

/* DEVICES: ------------------------------------------------------------------------------------ */

#Tactile-Device-Foot > .unity-button
{
    flex-shrink: 1;
}

#Tactile-Device-Foot > .unity-button > .unity-image
{
    flex-shrink: 0;
}

/* UPDATES: ------------------------------------------------------------------------------------ */

#Tactile-Updates-Asset-Root 
{
    margin-top: var(--gc-common-space-smaller);
    -unity-text-generator: standard;
}

#Tactile-Updates-Asset-Head 
{
    flex-direction: row;
    flex-wrap: nowrap;
    height: var(--gc-list-head-size);
    -unity-text-align: middle-left;
    overflow: hidden;
    background-color: var(--gc-color-bg-light);
    border-color: var(--gc-color-border-default);
    border-width: var(--gc-common-border-width);
}

#Tactile-Updates-Asset-Head > LabelTitle 
{
    flex-grow: 1;
    padding-left: var(--gc-common-space-smaller);
}

#Tactile-Updates-Asset-Head > Label 
{
    flex-grow: 0;
    margin: 0;
    width: auto;
    -unity-text-align: middle-right;
}

#Tactile-Updates-Asset-Head > Image 
{
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--gc-list-head-image-size);
    height: var(--gc-list-head-image-size);
    margin: var(--gc-list-head-image-margin) var(--gc-common-space-smaller);
}

#Tactile-Updates-Asset-Head > Button 
{
    flex-grow: 0;
    border-radius: 0;
    margin: 0;
    border-width: 0;
    border-color: var(--gc-color-border-default);
}

#Tactile-Updates-Asset-Body 
{
    max-height: 400px;
    background-color: var(--gc-color-bg-light);
    border-color: var(--gc-color-border-default);
    border-width: var(--gc-common-border-width);
    padding: var(--gc-common-space-small);
    padding-right: 3px;
    margin: -1px var(--gc-common-space-smallest) 0 var(--gc-common-space-smallest);
}

#Tactile-Updates-Asset-Body > Label
{
    white-space: normal;
}

