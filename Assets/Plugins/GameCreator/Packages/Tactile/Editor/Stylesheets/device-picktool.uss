#Tactile-Device-PickTool 
{
    margin-right: -2px;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
}

#Tactile-Device-PickTool > Label 
{
    padding-left: 4px;
    -unity-text-align: middle-left;
}

#Tactile-Device-PickTool > Button 
{
    margin-left: 2px;
    margin-right: 0;
    padding: 0 5px;
    height: var(--gc-list-head-size);
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
}

#Tactile-Device-PickTool > Button > Label 
{
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

#Tactile-Device-PickTool > Button > Image 
{
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
}