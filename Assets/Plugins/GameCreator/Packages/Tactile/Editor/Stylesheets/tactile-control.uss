.unity-vector2-field 
{
}

.unity-vector2-field .unity-composite-field__field-spacer
{
    display: none;
}

.unity-base-field
{
    margin-bottom: 1px;
}

.unity-toggle
{
    margin-top: 1px;
    margin-bottom: 1px;
    height: 20px;
}

.unity-toggle .unity-base-field
{
    margin-top: 0;
    margin-bottom: 0;
}

.unity-toggle > .unity-label
{
    -unity-text-align: middle-left;
}

PropertyElement #GC-PropertyElement-Head > Label
{
    padding-left: 4px;
}