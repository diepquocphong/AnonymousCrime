#Feature-Dialog 
{
    padding-top: 0;
    border-width: 0;
}

.points-edit-field
{
    flex-direction: row;
}

.points-edit-field__label
{
    margin-left: 3px;
    -unity-text-align: middle-left;
}

.points-edit-field__button
{
    height: 22px;
    margin-left: -1px;
    margin-right: -1px;

    flex-grow: 1;
}

.unity-list-view
{
    margin-top: 1px;
    margin-bottom: 2px;
}