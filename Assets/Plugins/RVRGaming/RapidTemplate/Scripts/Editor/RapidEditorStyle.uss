/* Spacer */
.unity-spacer {
    height: 4px;
}

/* Header Image */
.header-image {
    max-height: 60px;
    max-width: 240px;
    margin-left: 0px;
    margin-top: 5px;
    margin-bottom: 5px;
}

/* Foldout container */
.foldout {
    margin-bottom: 0px;
    padding: 1;
    background-color: #303030;
    overflow: hidden;
}

/* Foldout Header */
.foldout > .unity-foldout__toggle {
    padding: 4px 6px;
    margin: 0;
    background-color: #4f4f4f;
    border-bottom: 1px solid #2f2f2f;
    align-items: center;
    display: flex;
}

/* Hide Foldout Arrow (non-destructive) */
.foldout > .unity-toggle > .unity-toggle__checkmark {
    opacity: 0;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    visibility: hidden;
}

/* Foldout Body when expanded */
.foldout-expanded .unity-foldout__content {
    padding: 2px;
    padding-right: 20px; 
}

/* Ensure checkboxes and other toggles still work */
.property-field .unity-toggle__checkmark,
.visual-element .unity-toggle__checkmark {
    visibility: visible;
    width: 16px;
    height: 16px;
}

/* Foldout Label */
.foldout > Label {
    font-size: 14px;
    font-weight: bold;
    margin-left: 4px;
    color: white;
}

/* Property Fields */
.property-field {
    margin-bottom: 5px;
}

/* Labels */
.label {
    font-size: 12px;
    font-weight: bold;
    margin-top: 5px;
    margin-bottom: 5px;
}

/* Unity Events Label */
.unity-events-label {
    font-size: 16px;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
}
